APP_NAME=Hospital Referral API
# JSON array of allowed browser origins
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Local development credentials; Compose and FastAPI must use matching values.
POSTGRES_USER=referral
POSTGRES_PASSWORD=referral_local
POSTGRES_DB=referrals
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://referral:referral_local@127.0.0.1:5432/referrals

# Originals default to backend/var/documents, independent of the working directory.
# Set an absolute path to override. Keep this directory outside any public web root.
# DOCUMENT_STORAGE_DIR=/absolute/path/to/private/documents
DOCUMENT_MAX_BYTES=10485760
DOCUMENT_MAX_PAGES=100
DOCUMENT_MAX_TEXT_CHARS=2000000

# Browser/API Gemini is opt-in. Evaluation selects Gemini independently.
GEMINI_ENABLED=false
# Set a real key and an available generateContent model; never commit your .env.
# A configured file key wins over GEMINI_API_KEY in the process environment.
# GEMINI_API_KEY=
# GEMINI_MODEL=
GEMINI_TIMEOUT_SECONDS=60
GEMINI_MAX_INPUT_CHARS=100000
GEMINI_MAX_OUTPUT_TOKENS=8192
